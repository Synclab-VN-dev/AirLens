<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/os_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cấu hình đã lưu"
            android:textColor="@color/os_text_primary"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu đồng thời camera/mã hóa/âm thanh và đích OBS để dùng lại nhanh. Tối đa 20 cấu hình."
            android:textColor="@color/os_text_tertiary"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/profileName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Tên cấu hình, ví dụ 4K30 phòng khách"
            android:textColor="@color/os_text_primary"
            android:textColorHint="@color/os_text_tertiary"
            android:inputType="textCapSentences"
            android:maxLength="48"
            android:singleLine="true"
            android:background="@drawable/bg_minimal_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSaveCurrentProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Lưu cấu hình hiện tại"
            android:textAllCaps="false"
            android:textColor="@color/os_black"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_minimal_btn"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DANH SÁCH"
            android:textColor="@color/os_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/profileList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnBackProfiles"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Quay lại"
            android:textAllCaps="false"
            android:textColor="@color/os_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_minimal_btn_ghost"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
